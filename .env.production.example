# Copy to an ignored .env.production, chmod 600, or supply through a private secret manager.
# Use three DIFFERENT random hex passwords (32+ bytes each), URL-safe without escaping.
BOOTSTRAP_DB_PASSWORD=CHANGE_ME
OWNER_DB_PASSWORD=CHANGE_ME
RUNTIME_DB_PASSWORD=CHANGE_ME
RATE_LIMIT_SECRET=CHANGE_ME_at_least_32_random_characters
POSTGRES_DB=unipath
PRODUCTION_ORIGIN=https://staging.example.edu
# Determine the host TLS proxy source as seen by Nginx (often the Docker bridge gateway).
# Use its single /32 address, and verify spoofed X-Forwarded-For cannot bypass it.
TRUSTED_EDGE_CIDR=127.0.0.1/32
WEB_PORT=8080
SEED_DEMO=false
