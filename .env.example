# Copy to .env. Replace the two CHANGE_ME values before first startup.
POSTGRES_USER=unipath
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=unipath
DATABASE_URL=postgresql://unipath:CHANGE_ME_database_password@localhost:5432/unipath?schema=public&connection_limit=10&pool_timeout=10
RATE_LIMIT_SECRET=CHANGE_ME_random_string_at_least_32_characters
NODE_ENV=development
PORT=3001
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Comma-separated exact origins; Vite development runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
COOKIE_NAME=unipath_session
COOKIE_SECURE=false
SESSION_HOURS=168
# Keep 0 unless behind a trusted proxy. Number of trusted hops, never 'true'.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=12
SEED_DEMO=true
