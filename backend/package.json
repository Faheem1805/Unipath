{
  "name": "@unipath/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema ../database/schema.prisma",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy --schema ../database/schema.prisma",
    "db:seed": "tsx --env-file=../.env src/seed.ts",
    "admin:create": "tsx --env-file=../.env src/create-admin.ts"
  },
  "dependencies": {
    "@unipath/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76",
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.19.0"
  }
}
